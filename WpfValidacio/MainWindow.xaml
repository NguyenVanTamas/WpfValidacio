<Window
    x:Class="WpfValidacio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:WpfValidacio"
    mc:Ignorable="d"
    Title="MainWindow" Height="750" Width="450"
    Background="Gray"
>
    <Grid Margin="35">
        <Border
            Background="white"
            CornerRadius="20"
            Padding="30"
        >
            <StackPanel>
                <TextBlock
                    Text="REGISZTRÁCIÓ"
                    FontSize="28"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"
                    Foreground="Gray"
                    Margin="0,0,0,25"
                />
                <TextBlock
                    Text="Név"
                    FontWeight="Bold"
                    Margin="0,0,0,5"
                />
                <TextBox
                    x:Name="txtName"
                    Height="40"
                    FontSize="16"
                    Padding="8"
                    Margin="0,0,0,15"
                />
                <TextBlock
                    Text="Email"
                    FontWeight="Bold"
                    Margin="0,0,0,5"
                />
                <TextBox
                    x:Name="txtEmail"
                    Height="40"
                    FontSize="16"
                    Padding="8"
                    Margin="0,0,0,15"
                />
                <TextBlock
                    Text="Jelszó"
                    FontWeight="Bold"
                    Margin="0,0,0,5"
                />
                <TextBox
                    x:Name="txtPassword"
                    Height="40"
                    FontSize="16"
                    Padding="8"
                    Margin="0,0,0,15"
                />
                <TextBlock
                    Text="Jelszó újra"
                    FontWeight="Bold"
                    Margin="0,0,0,5"
                />
                <TextBox
                    x:Name="txtPasswordAgain"
                    Height="40"
                    FontSize="16"
                    Padding="8"
                    Margin="0,0,0,15"
                />
                <TextBlock
                    Text="Életkor"
                    FontWeight="Bold"
                    Margin="0,0,0,5"
                />
                <TextBox
                    x:Name="txtAge"
                    Height="40"
                    FontSize="16"
                    Padding="8"
                    Margin="0,0,0,15"
                />
                <CheckBox
                    x:Name="checkTerms"
                    Content="Elfogadom a felhasználási feltételeket"
                    FontSize="14"
                    Margin="0,5,0,20"
                />
                <Button
                    Content="Regisztráció"
                    Height="50"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="White"
                    Background="Gray"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="Button_Click"
                />
            </StackPanel>
        </Border>
    </Grid>
</Window>
